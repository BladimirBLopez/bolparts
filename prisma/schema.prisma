generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum Condition {
  NEW
  USED
}

enum TipoCategoria {
  VEHICULO
  REPUESTO
}

enum TipoVehiculo {
  AUTO
  MOTO
  CAMION
}

enum PlanNivel {
  NINGUNO
  DESTACADO
  SUPERIOR
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoPedido {
  ABIERTO
  RESUELTO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  phone         String?
  image         String?
  role          Role      @default(USER)

  businessBanner      String?
  businessDescription String?
  businessHours       String?
  businessAddress     String?
  nivelPlan           PlanNivel @default(NINGUNO)
  planExpiraEn        DateTime?
  latitude            Float?
  longitude           Float?

  accounts  Account[]
  sessions  Session[]
  listings       Listing[]
  reviewsWritten  Review[]  @relation("ReviewsWritten")
  reviewsReceived Review[]  @relation("ReviewsReceived")
  favorites Favorite[]
  solicitudesPlan SolicitudPlan[]
  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SolicitudPlan {
  id              String          @id @default(cuid())
  nivel           PlanNivel
  comprobanteUrl  String
  estado          EstadoSolicitud @default(PENDIENTE)

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now())
  revisadaEn      DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String         @id @default(cuid())
  name     String
  slug     String         @unique
  tipo     TipoCategoria  @default(REPUESTO)
  imageUrl String?

  listings Listing[]
}

model Brand {
  id       String        @id @default(cuid())
  name     String        @unique
  tipo     TipoVehiculo  @default(AUTO)

  models   CarModel[]
  listings Listing[]
  pedidos  Pedido[]
  compatibilidades Compatibilidad[]
}

model CarModel {
  id       String    @id @default(cuid())
  name     String

  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id])

  listings Listing[]
  pedidos  Pedido[]
  compatibilidades Compatibilidad[]
}

model Listing {
  id          String      @id @default(cuid())
  slug        String?     @unique
  title       String
  description String?

  price       Float
  condition   Condition

  city        String
  department  String

  yearFrom    Int?
  yearTo      Int?
  phone       String?

  userId      String
  user        User        @relation(fields: [userId], references: [id])

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])

  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])

  modelId     String?
  model       CarModel?   @relation(fields: [modelId], references: [id])

  numeroParte String?
  vistas      Int      @default(0)
  peso        Float?
  largo       Float?
  alto        Float?
  ancho       Float?

  images      Image[]
  favorites   Favorite[]
  reports     Report[]
  compatibilidades Compatibilidad[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Compatibilidad {
  id        String   @id @default(cuid())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])

  modelId   String?
  model     CarModel? @relation(fields: [modelId], references: [id])

  yearFrom  Int?
  yearTo    Int?
}

model Pedido {
  id          String       @id @default(cuid())
  titulo      String
  descripcion String?

  city        String
  department  String

  yearFrom    Int?
  yearTo      Int?
  phone       String?

  estado      EstadoPedido @default(ABIERTO)

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])

  modelId     String?
  model       CarModel?    @relation(fields: [modelId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  url       String

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())

  userId    String
  listingId String

  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?

  authorId  String
  author    User     @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)

  sellerId  String
  seller    User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, sellerId])
}

enum ReportReason {
  FAKE
  SOLD
  INAPPROPRIATE
  SCAM
  OTHER
}

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  details   String?

  reporterId String
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reporterId, listingId])
}
